generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  INDIVIDUAL
  BUSINESS
}

enum WorkOrderStatus {
  DRAFT
  DIAGNOSIS
  ESTIMATE_SENT
  APPROVED
  IN_PROGRESS
  QA
  COMPLETED
  INVOICED
  PAID
}

enum EmployeeRole {
  ADMIN
  MANAGER
  MECHANIC
}

model Client {
  id          String    @id @default(cuid())
  type        ClientType
  name        String
  email       String?   @unique
  phone       String
  businessTaxId String?
  address     String?
  createdAt   DateTime  @default(now())
  vehicles    Vehicle[]
  workOrders  WorkOrder[]
}

model Vehicle {
  id          String   @id @default(cuid())
  clientId    String
  make        String
  model       String
  year        Int
  vin         String   @unique
  plate       String   @unique
  mileage     Int
  history     String?
  client      Client   @relation(fields: [clientId], references: [id])
  workOrders  WorkOrder[]
  createdAt   DateTime @default(now())
}

model Employee {
  id          String      @id @default(cuid())
  name        String
  email       String      @unique
  passwordHash String
  role        EmployeeRole
  workOrders  WorkOrder[]
  createdAt   DateTime @default(now())
}

model WorkOrder {
  id            String          @id @default(cuid())
  clientId       String
  vehicleId      String
  assignedToId   String?
  status         WorkOrderStatus @default(DRAFT)
  diagnosis      String?
  technicianNotes String?
  openedAt       DateTime @default(now())
  approvedAt     DateTime?
  closedAt       DateTime?
  laborHours     Float    @default(0)
  laborRate      Float    @default(0)
  client         Client   @relation(fields: [clientId], references: [id])
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  assignedTo     Employee? @relation(fields: [assignedToId], references: [id])
  items          WorkOrderItem[]
  estimate       Estimate?
  invoice        Invoice?
  photos         WorkOrderPhoto[]
}

model WorkOrderItem {
  id          String   @id @default(cuid())
  workOrderId String
  description String
  quantity    Int
  unitPrice   Float
  isPart      Boolean  @default(false)
  partId      String?
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  part        InventoryPart? @relation(fields: [partId], references: [id])
}

model InventoryPart {
  id            String @id @default(cuid())
  sku           String @unique
  name          String
  description   String?
  stockQty      Int
  reorderLevel  Int
  unitCost      Float
  unitPrice     Float
  items         WorkOrderItem[]
  createdAt     DateTime @default(now())
}

model Estimate {
  id            String   @id @default(cuid())
  workOrderId   String   @unique
  subtotal      Float
  tax           Float
  total         Float
  approved      Boolean  @default(false)
  approvedAt    DateTime?
  signatureData String?
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
}

model Invoice {
  id            String   @id @default(cuid())
  workOrderId   String   @unique
  number        String   @unique
  subtotal      Float
  tax           Float
  total         Float
  issuedAt      DateTime @default(now())
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id])
  payments      Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId      String
  amount        Float
  method        String
  reference     String?
  paidAt        DateTime @default(now())
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
}

model ScheduleSlot {
  id            String   @id @default(cuid())
  workOrderId   String?
  title         String
  startTime     DateTime
  endTime       DateTime
  reminderSent  Boolean @default(false)
}

model WorkOrderPhoto {
  id          String   @id @default(cuid())
  workOrderId String
  url         String
  note        String?
  createdAt   DateTime @default(now())
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
}
